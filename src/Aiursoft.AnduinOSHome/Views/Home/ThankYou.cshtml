@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    @if (Model.IsTorrent)
    {
        <script>
            function switchTorrentPlatform(name, button) {
                document.querySelectorAll('.torrent-platform-panel').forEach(panel => {
                    panel.classList.toggle('d-none', panel.id !== 'torrent-panel-' + name);
                });
                document.querySelectorAll('#torrent-platform-tabs [data-torrent-platform]').forEach(tab => {
                    const active = tab === button;
                    tab.classList.toggle('active', active);
                    tab.setAttribute('aria-pressed', active.toString());
                });
            }

            document.addEventListener('DOMContentLoaded', function () {
                const detectedPlatform = (navigator.userAgentData?.platform || navigator.platform || navigator.userAgent).toLowerCase();
                const platform = detectedPlatform.includes('mac')
                    ? 'macos'
                    : detectedPlatform.includes('linux') || detectedPlatform.includes('x11')
                        ? 'linux'
                        : 'windows';
                const button = document.querySelector('[data-torrent-platform="' + platform + '"]');
                if (button)
                    switchTorrentPlatform(platform, button);

                const screenshotModal = document.getElementById('torrent-screenshot-modal');
                const screenshotPreview = document.getElementById('torrent-screenshot-preview');
                screenshotModal.addEventListener('show.bs.modal', function (event) {
                    const trigger = event.relatedTarget;
                    screenshotPreview.src = trigger.dataset.torrentImage;
                    screenshotPreview.alt = trigger.dataset.torrentAlt;
                });
                screenshotModal.addEventListener('hidden.bs.modal', function () {
                    screenshotPreview.src = '';
                    screenshotPreview.alt = '';
                });
            });
        </script>
    }
    @if (!string.IsNullOrEmpty(Model.DownloadUrl))
    {
        <script>
            setTimeout(function () {
                window.location.href = '@Html.Raw(Model.DownloadUrl)';
            }, 1000);
        </script>
    }
}

