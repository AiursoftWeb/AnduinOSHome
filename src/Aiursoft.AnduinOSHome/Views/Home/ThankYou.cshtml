                            <h4>@Localizer["Download the ISO"]</h4>
                            <p class="text-muted mb-0">@Localizer["Keep the client open until the AnduinOS ISO reaches 100%."]</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card h-100 border-0 shadow-sm overflow-hidden">
                        <button type="button" class="border-0 bg-transparent p-0 position-relative d-block w-100"
                                data-bs-toggle="modal" data-bs-target="#torrent-screenshot-modal"
                                data-torrent-image="@Url.Content("~/images/torrent/verify-iso.png")"
                                data-torrent-alt="@Localizer["The downloaded AnduinOS ISO and checksum files"]"
                                aria-label="@Localizer["View full-size screenshot: Verify the ISO"]">
                            <img src="~/images/torrent/verify-iso.png"
                                 alt="@Localizer["The downloaded AnduinOS ISO and checksum files"]"
                                 class="card-img-top" style="aspect-ratio: 16 / 10; object-fit: cover; object-position: top;" loading="lazy" />
                            <span class="position-absolute top-0 end-0 m-3 d-inline-flex align-items-center justify-content-center rounded-circle bg-dark bg-opacity-75 text-white shadow"
                                  style="width: 36px; height: 36px;" aria-hidden="true">
                                <i data-lucide="maximize-2" style="width: 17px; height: 17px;"></i>
