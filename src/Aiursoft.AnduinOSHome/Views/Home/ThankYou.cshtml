@* ── Phase 1: Create Installation Media ── *@
<section class="py-6 bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Phase 1"]</span>
            <h2 class="h1">@Localizer["Create Installation Media"]</h2>
            <p class="text-muted fs-lg">@Localizer["Verify your download and create a bootable USB drive."]</p>
        </div>

        @* Checksum Verification *@
        <div class="row mb-5">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-10 me-3" style="width: 48px; height: 48px; min-width: 48px;">
                                <i data-lucide="fingerprint" class="text-primary" style="width: 22px; height: 22px;"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h4 class="mt-0">@Localizer["1. Verify the checksum"]</h4>
                                <p class="fs-lg">@Localizer["After downloading the ISO file, verify its integrity to ensure it has not been tampered with."]</p>
                                <div class="row align-items-center g-4">
                                    <div class="col-lg-4">
                                        <div class="bg-dark rounded-3 p-3 mb-3">
                                            <code class="text-white" style="font-size: 0.9rem;">sha256sum ./@Model.IsoFileName</code>
                                        </div>
                                        <p class="fs-lg mb-0">
                                            @Localizer["Compare the output with the"]
                                            <a id="official-checksum-link" href="@Model.ChecksumUrl" target="_blank">@Localizer["official SHA256 checksum"]</a>@Localizer[". If they match, your ISO is valid."]
                                        </p>
                                    </div>
                                    <div class="col-lg-8">
                                        <div class="bg-dark rounded-3 overflow-hidden shadow-sm" role="img" aria-label="@Localizer["Verify ISO checksum"]">
                                            <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom border-secondary">
                                                <span class="rounded-circle bg-danger" style="width: 10px; height: 10px;"></span>
                                                <span class="rounded-circle bg-warning" style="width: 10px; height: 10px;"></span>
                                                <span class="rounded-circle bg-success" style="width: 10px; height: 10px;"></span>
                                                <span class="text-white-50 small ms-2">~/Downloads</span>
                                            </div>
                                            <div class="p-4 font-monospace text-start">
                                                <div><span class="text-success">$</span> <code class="text-white">sha256sum ./@Model.IsoFileName</code></div>
                                                <div class="text-white-50 mt-2">&lt;SHA256 hash&gt;&nbsp; ./@Model.IsoFileName</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Platform Tabs *@
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-bottom pt-4 pb-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h4 class="mb-0">@Localizer["2. Create a bootable USB drive"]</h4>
                    <div class="d-flex gap-2 flex-wrap" role="group" id="platform-tabs">
                        <button class="btn btn-outline-primary rounded-pill active" type="button"
                                data-install-platform="windows">
                            <i class="fab fa-windows me-1"></i>@Localizer["Windows"]
                        </button>
                        <button class="btn btn-outline-primary rounded-pill" type="button"
                                data-install-platform="linux">
                            <i class="fab fa-linux me-1"></i>@Localizer["Linux"]
                        </button>
                        <button class="btn btn-outline-primary rounded-pill" type="button"
                                data-install-platform="macos">
                            <i class="fab fa-apple me-1"></i>@Localizer["macOS"]
                        </button>
                        <button class="btn btn-outline-primary rounded-pill" type="button"
                                data-install-platform="ventoy">
                            <i data-lucide="usb" style="width:14px;height:14px;" class="me-1"></i>Ventoy
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                @* Windows Panel *@
                <div class="collapse show platform-panel" id="panel-windows">
                    <div class="row align-items-center g-4">
                        <div class="col-lg-6">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1">Rufus</span>
                                <span class="text-muted small">@Localizer["Free, open-source USB flashing tool"]</span>
                            </div>
                            <p class="text-muted mb-3">@Localizer["We recommend using Rufus to create the bootable USB drive. Make sure to select"] <strong>@Localizer["dd mode"]</strong> @Localizer["instead of ISO mode."]</p>
                            <div class="bg-warning-subtle border-start border-4 border-warning rounded-2 p-3 mb-3">
                                <p class="fw-semibold mb-1 small">⚠️ @Localizer["Use dd mode, not ISO mode!"]</p>
                                <p class="mb-0 small text-muted">@Localizer["ISO mode may cause AnduinOS to fail to boot."]</p>
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="https://rufus.ie/" class="btn btn-primary btn-sm btn-pill" target="_blank">
                                    <i data-lucide="download" style="width: 14px; height: 14px;" class="me-1"></i>@Localizer["Download Rufus"]
                                </a>
                                <a href="https://docs.anduinos.com/Install/Burn-A-USB-Stick.html" class="btn btn-outline-primary btn-sm btn-pill">
                                    @Localizer["Full Guide"] <i data-lucide="arrow-right" style="width: 14px; height: 14px;"></i>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-6 text-center">
                            <img src="~/images/rufus.webp" alt="Rufus" class="img-fluid rounded-3" style="max-height: 280px;" loading="lazy" />
                        </div>
                    </div>
                </div>

                @* Linux Panel *@
                <div class="collapse platform-panel" id="panel-linux">
                    <div class="row align-items-center g-4">
                        <div class="col-lg-6">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Impression</span>
                                <span class="text-muted small">@Localizer["Simple, modern ISO flashing tool"]</span>
                            </div>
                            <p class="text-muted mb-3">@Localizer["Impression is the most user-friendly way to flash the ISO on Linux. Install it via Flatpak:"]</p>
                            <div class="d-flex gap-2 flex-wrap mb-3">
                                <a href="https://flathub.org/en/apps/io.gitlab.adhami3310.Impression" class="btn btn-primary btn-sm btn-pill" target="_blank">
                                    <i data-lucide="download" style="width: 14px; height: 14px;" class="me-1"></i>@Localizer["Get Impression on Flathub"]
                                </a>
                                <a href="https://docs.anduinos.com/Install/Burn-A-USB-Stick.html" class="btn btn-outline-primary btn-sm btn-pill">
                                    @Localizer["Full Guide"] <i data-lucide="arrow-right" style="width: 14px; height: 14px;"></i>
                                </a>
                            </div>
                            <p class="text-muted small mb-2">@Localizer["Or use the command line:"]</p>
                            <div class="bg-dark rounded-3 p-2 mb-0">
                                <code class="text-white" style="font-size: 0.8rem;">sudo dd if=./AnduinOS.iso of=&lt;device&gt; status=progress oflag=sync bs=4M</code>
                            </div>
                        </div>
                        <div class="col-lg-6 text-center">
                            <img src="~/images/impression.webp" alt="Impression" class="img-fluid rounded-3" style="max-height: 280px;" loading="lazy" />
                        </div>
                    </div>
                </div>

                @* macOS Panel *@
                <div class="collapse platform-panel" id="panel-macos">
                    <div class="row align-items-center g-4">
                        <div class="col-lg-6">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">BalenaEtcher</span>
                                <span class="text-muted small">@Localizer["Cross-platform, safe ISO flasher"]</span>
                            </div>
                            <p class="text-muted mb-3">@Localizer["BalenaEtcher is a cross-platform graphical tool that makes flashing ISO images simple and safe."]</p>
                            <ol class="small text-muted mb-3">
                                <li>@Localizer["Download and install"] <a href="https://etcher.balena.io/">BalenaEtcher</a>.</li>
                                <li>@Localizer["Click \"Flash from file\" and select the AnduinOS ISO."]</li>
                                <li>@Localizer["Select your target USB drive and click \"Flash!\"."]</li>
                            </ol>
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="https://etcher.balena.io/" class="btn btn-primary btn-sm btn-pill" target="_blank">
                                    <i data-lucide="download" style="width: 14px; height: 14px;" class="me-1"></i>@Localizer["Download Etcher"]
                                </a>
                                <a href="https://docs.anduinos.com/Install/Burn-A-USB-Stick.html" class="btn btn-outline-primary btn-sm btn-pill">
                                    @Localizer["Full Guide"] <i data-lucide="arrow-right" style="width: 14px; height: 14px;"></i>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-6 text-center d-none d-lg-block">
                            <div class="bg-light rounded-4 d-inline-flex align-items-center justify-content-center" style="width: 120px; height: 120px;">
                                <i class="fab fa-apple fa-4x text-dark"></i>
                            </div>
                        </div>
                    </div>
                </div>

                @* Ventoy Panel *@
                <div class="collapse platform-panel" id="panel-ventoy">
                    <div class="row align-items-center g-4">
                        <div class="col-lg-6">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1">Ventoy</span>
                                <span class="text-muted small">@Localizer["Multi-ISO, reusable USB solution"]</span>
                            </div>
                            <p class="text-muted mb-3">@Localizer["If you frequently install operating systems, Ventoy lets you keep your USB drive usable for regular storage while still being bootable. Simply copy the ISO file onto the drive and boot."]</p>
                            <ol class="small text-muted mb-3">
                                <li>@Localizer["Install"] <a href="https://www.ventoy.net/">Ventoy</a> @Localizer["to your USB drive."]</li>
                                <li>@Localizer["Copy the AnduinOS ISO onto the drive like a regular file."]</li>
                                <li>@Localizer["Boot from USB and select the ISO from Ventoy's menu."]</li>
                            </ol>
                            <p class="small text-success mb-3 fw-semibold">@Localizer["No repeated flashing or erasing needed!"]</p>
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="https://www.ventoy.net/" class="btn btn-primary btn-sm btn-pill" target="_blank">
                                    <i data-lucide="download" style="width: 14px; height: 14px;" class="me-1"></i>@Localizer["Download Ventoy"]
                                </a>
                                <a href="https://docs.anduinos.com/Install/Burn-A-USB-Stick.html" class="btn btn-outline-primary btn-sm btn-pill">
                                    @Localizer["Full Guide"] <i data-lucide="arrow-right" style="width: 14px; height: 14px;"></i>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-6 text-center d-none d-lg-block">
                            <div class="bg-light rounded-4 d-inline-flex align-items-center justify-content-center" style="width: 120px; height: 120px;">
                                <i data-lucide="usb" style="width: 56px; height: 56px;" class="text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── Phase 2: Install AnduinOS ── *@
<section class="py-6 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Phase 2"]</span>
            <h2 class="h1">@Localizer["Install AnduinOS"]</h2>
            <p class="text-muted fs-lg">@Localizer["Boot from USB and follow the graphical installer."]</p>
        </div>

        <div class="row align-items-center g-5">
            @* Left: Installation steps *@
            <div class="col-lg-6">
                @* Pre-installation tips *@
                <div class="bg-white border-start border-4 border-primary rounded-2 p-3 mb-4 shadow-sm">
                    <p class="fw-semibold mb-2">💡 @Localizer["Optional Pre-installation Steps"]</p>
                    <ul class="mb-0 small">
                        <li><strong>@Localizer["Secure Boot"]</strong> — <a href="https://docs.anduinos.com/Install/First-Boot-For-Secure-Boot.html">@Localizer["Enable it in BIOS before booting"]</a></li>
                        <li><strong>@Localizer["NVMe SSD?"]</strong> — <a href="https://docs.anduinos.com/Install/Change-NVME-LBA-Size.html">@Localizer["Change LBA size to 4K for optimal performance"]</a></li>
                        <li><strong>@Localizer["Dual Boot?"]</strong> — <a href="https://docs.anduinos.com/Install/Dual-Boot-With-Windows.html">@Localizer["Read the dual-boot guide first"]</a></li>
                    </ul>
                </div>

                @* Boot from USB *@
                <h4 class="fw-bold mb-2">@Localizer["Boot from USB"]</h4>
                <p class="text-muted">@Localizer["Common boot menu keys:"] <strong>F12, F11, Esc, F10,</strong> @Localizer["or"] <strong>@Localizer["Vol Down + Power"]</strong></p>
                <ol class="mb-4">
                    <li>@Localizer["Insert the USB drive and power on your computer."]</li>
                    <li>@Localizer["Press your manufacturer's boot menu key immediately."]</li>
                    <li>@Localizer["Select the USB drive in the boot menu."]</li>
                    <li>@Localizer["In GRUB, select your language and choose"] <strong>@Localizer["Install AnduinOS"]</strong>.</li>
                </ol>

                <div class="bg-white border-start border-4 border-primary rounded-2 p-3 small">
                    <h5 class="h6 mb-2">@Localizer["Secure Boot Enrollment"]</h5>
                    <p class="mb-2">@Localizer["If the blue MOK Manager screen appears on the first restart, press any key when prompted. Choose Enroll MOK → Continue → Yes, enter 123456, then choose Reboot."]</p>
                    <a href="https://docs.anduinos.com/Install/First-Boot-For-Secure-Boot.html">@Localizer["Secure Boot Guide"]</a>
                </div>
            </div>

            @* Right: First-restart Secure Boot tutorial *@
            <div class="col-lg-6 text-center">
                <figure class="card border-0 shadow-lg mb-0">
                    <div class="card-body p-3">
                        <picture>
                            <source media="(prefers-reduced-motion: reduce)" srcset="@Url.Content("~/images/after-installation/mok-enrollment-still.png")" />
                            <img src="~/images/after-installation/mok-enrollment.gif"
                                 alt="@Localizer["MOK Manager showing the Secure Boot enrollment steps after the first restart"]"
                                 class="img-fluid rounded-3 w-100 h-auto"
                                 width="1280" height="800"
                                 loading="lazy" />
                        </picture>
                    </div>
                    <figcaption class="card-footer bg-light border-0 small py-2">
                        <a href="~/images/after-installation/mok-enrollment.gif" target="_blank" rel="noopener">@Localizer["Open the MOK enrollment animation"]</a>
                    </figcaption>
                </figure>
            </div>
        </div>
    </div>
</section>

@* ── Phase 3: First Boot Setup ── *@
<section class="py-6 bg-white" id="after-installation">
    <div class="container">
        <div class="text-center mb-5">
            <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Phase 3"]</span>
            <h2 class="h1">@Localizer["After Installation"]</h2>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <article class="card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column p-4">
                        <h3 class="h5 mb-3">@Localizer["Start with Welcome Center"]</h3>
                        <a href="~/images/after-installation/welcome-complete-en.webp" target="_blank" rel="noopener"
                           class="d-block rounded-3 mb-3" aria-label="@Localizer["View full-size screenshot: Welcome Center"]">
                            <img src="~/images/after-installation/welcome-complete-en.webp" alt="@Localizer["Welcome Center with the Start Setup button"]"
                                 class="img-fluid rounded-3 w-100 h-auto" width="1600" height="1200" loading="lazy" />
                        </a>
                        <p class="text-muted small mb-3">@Localizer["Welcome Center opens at your first sign-in. Use it to choose your appearance, taskbar layout, and firewall settings. You can open it again from the app menu."]</p>
                        <div class="mt-auto">
                            <a href="https://docs.anduinos.com/Applications/System/Welcome-Center/Welcome-Center.html" class="btn btn-outline-primary btn-sm btn-pill">
                                @Localizer["Welcome Center Guide"] <i data-lucide="arrow-right" class="ms-1" width="14" height="14" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </article>
            </div>

            <div class="col-lg-4 col-md-6">
                <article class="card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column p-4">
                        <h3 class="h5 mb-3">@Localizer["Update Your System"]</h3>
                        <a href="~/images/after-installation/control-panel-updates-en.webp" target="_blank" rel="noopener"
                           class="d-block rounded-3 mb-3" aria-label="@Localizer["View full-size screenshot: System updates"]">
                            <img src="~/images/after-installation/control-panel-updates-en.webp" alt="@Localizer["Software Source in Control Panel with the Check for Updates button"]"
                                 class="img-fluid rounded-3 w-100 h-auto" width="1600" height="1200" loading="lazy" />
                        </a>
                        <p class="text-muted small mb-3">@Localizer["Connect to the internet, then open Control Panel → Programs → Software Source and choose Check for Updates. You can also check the Updates tab in App Store."]</p>
                        <div class="mt-auto">
                            <a href="https://docs.anduinos.com/Install/Update-Your-System.html" class="btn btn-outline-primary btn-sm btn-pill">
                                @Localizer["Update Guide"] <i data-lucide="arrow-right" class="ms-1" width="14" height="14" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </article>
            </div>

            <div class="col-lg-4 col-md-6">
                <article class="card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column p-4">
                        <h3 class="h5 mb-3">@Localizer["Check Your Btrfs Snapshots"]</h3>
                        <a href="~/images/after-installation/btrfs-snapshots.webp" target="_blank" rel="noopener"
                           class="d-block rounded-3 mb-3" aria-label="@Localizer["View full-size screenshot: Disk Snapshots Manager"]">
                            <img src="~/images/after-installation/btrfs-snapshots.webp" alt="@Localizer["Disk Snapshots Manager showing System Recovery and Personal Files Recovery"]"
                                 class="img-fluid rounded-3 w-100 h-auto" style="aspect-ratio: 4 / 3; object-fit: contain; background: #000;"
                                 width="970" height="770" loading="lazy" />
                        </a>
                        <p class="text-muted small mb-2">@Localizer["On Btrfs, open Control Panel → Backup and Recovery → System Snapshots to check your recovery points. Copy-on-write snapshots let you roll back a bad update or recover an earlier version of a file."]</p>
                        <p class="text-muted small mb-3">@Localizer["Keep an external backup for protection against disk failure."]</p>
                        <div class="mt-auto d-flex flex-wrap align-items-center gap-2">
                            <a href="https://docs.anduinos.com/Skills/System-Management/Btrfs-Backup-and-Recovery.html" class="btn btn-outline-primary btn-sm btn-pill">
                                @Localizer["Snapshot Guide"] <i data-lucide="arrow-right" class="ms-1" width="14" height="14" aria-hidden="true"></i>
                            </a>
                            <a href="https://docs.anduinos.com/Install/Backup-And-Restore.html" class="small">@Localizer["External Backup Guide"]</a>
                        </div>
                    </div>
                </article>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-3 mt-4 small">
            <a href="https://docs.anduinos.com/Install/Switch-To-Your-Language.html">@Localizer["Switch Language"]</a>
            <a href="https://docs.anduinos.com/Install/Install-Drivers.html">@Localizer["Install Drivers"]</a>
        </div>
    </div>
</section>

@* ── Community & Support ── *@
