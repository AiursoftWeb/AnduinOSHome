<vc:marketing-navbar></vc:marketing-navbar>

@* ── Hero Banner ── *@
<section class="landing-intro text-bg-dark pt-5 pt-lg-6 pb-5 pb-lg-7">
    <div class="landing-intro-content container h-100">
        <div class="row align-items-center h-100">
            <div class="col-lg-7">
                <div class="mb-3">
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-3 py-2 me-2">
                        <i data-lucide="check-circle" style="width: 14px; height: 14px;" class="me-1"></i>@Localizer["Download Started"]
                    </span>
                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50 px-3 py-2 me-2">~2.5 GB ISO</span>
                    <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-50 px-3 py-2">100% @Localizer["Free & Open Source"]</span>
                </div>
                <h1 class="my-4 text-white" style="font-size: 3rem; font-weight: 800; line-height: 1.15;">
                    @Localizer["Thank you for downloading"]
                    <span class="text-primary">@Localizer["AnduinOS"]</span>
                </h1>
                <p class="text-lg text-white-50 mb-4" style="font-size: 1.25rem; max-width: 540px;">
                    @Localizer["Your AnduinOS journey starts here. Follow the steps below to get up and running in under 30 minutes."]
                </p>
                @if (!string.IsNullOrEmpty(Model.DownloadUrl))
                {
                    <p class="text-white-50 small mb-0">
                        @Localizer["If your download doesn't start automatically,"] <a href="@Model.DownloadUrl" class="text-primary text-decoration-none">@Localizer["click here"]</a>.
                    </p>
                }
            </div>
            <div class="col-lg-5 d-none d-lg-flex mx-auto text-center">
                <div class="landing-intro-screenshot">
                    <img src="sc.webp" alt="AnduinOS Main screenshot" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</section>

