@model List<Aiursoft.AnduinOSHome.Entities.Hardware>
@if (Model.Count > 0)
{
    <section id="recommended-hardware" class="py-5 bg-light">
        <div class="container">
            <h2>@Localizer["AnduinOS recommended hardware"]</h2>
            <p class="text-muted">@Localizer["Real devices, tested configurations, and practical installation guidance."]</p>
            <partial name="_HardwareCards" model="Model" />
            <a asp-controller="Hardware" asp-action="Index" class="btn btn-outline-primary">@Localizer["Browse all hardware"]</a>
        </div>
    </section>
}
