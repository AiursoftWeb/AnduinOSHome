@using Aiursoft.AnduinOSHome.Services.FileStorage
@model Aiursoft.AnduinOSHome.Views.Shared.Components.FileUpload.FileUploadViewModel
@inject IViewLocalizer Localizer
@inject StorageService Storage
@inject IHtmlGenerator HtmlGenerator
@{
    var fileInputId = $"file-input-{Model.UniqueId}";
    var progressId = $"progress-{Model.UniqueId}";
    var progressbarId = $"progressbar-{Model.UniqueId}";

    var defaultValue = Model.AspFor.Model as string;
    var defaultFileUrl = string.IsNullOrWhiteSpace(defaultValue) ? null : Storage.RelativePathToInternetUrl(defaultValue, Model.IsVault);
    var maxFileSize = Model.MaxSizeInMb > 0 ? $"{Model.MaxSizeInMb}M" : null;

    // Use custom FieldName if provided, otherwise use AspFor.Name
    var fieldName = Model.FieldName ?? Model.AspFor.Name;

    var hiddenInputTag = HtmlGenerator.GenerateTextBox(
        ViewContext,
        Model.AspFor.ModelExplorer,
        fieldName,  // Use the override name if provided
        Model.AspFor.Model,
        format: null,
        htmlAttributes: new { style = "width:0;height:0;padding:0;border:none;" });
}

<div data-file-upload data-field-name="@fieldName" data-size-in-mb="@Model.MaxSizeInMb"
     data-valid-extensions="@Model.AllowedExtensions" data-upload-url="@Model.UploadEndpoint">
<input
    form="fakeForm"
    type="file"
    id="@fileInputId"
    class="dropify"
    data-show-remove="false"
    data-allowed-file-extensions="@Model.AllowedExtensions"
    data-default-file="@defaultFileUrl"
    data-max-file-size="@maxFileSize" />
<div id="@progressId" class="progress mb-3 mt-3 d-none">
    <div id="@progressbarId" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar"></div>
</div>
@hiddenInputTag
<div class="file-upload-loc-data" hidden>
    <span data-key="default">@Localizer["Drag and drop a file here or click"]</span>
    <span data-key="replace">@Localizer["Drag and drop or click to replace"]</span>
    <span data-key="remove">@Localizer["Remove"]</span>
    <span data-key="error">@Localizer["Ooops, something wrong happended."]</span>
    <span data-key="fileSize">@Localizer["The file size is too big ({{ value }} max)."]</span>
    <span data-key="minWidth">@Localizer["The image width is too small ({{ value }}px min)."]</span>
    <span data-key="maxWidth">@Localizer["The image width is too big ({{ value }}px max)."]</span>
    <span data-key="minHeight">@Localizer["The image height is too small ({{ value }}px min)."]</span>
    <span data-key="maxHeight">@Localizer["The image height is too big ({{ value }}px max)."]</span>
    <span data-key="imageFormat">@Localizer["The image format is not allowed ({{ value }} only)."]</span>
    <span data-key="fileExtension">@Localizer["The file is not allowed ({{ value }} only)."]</span>
    <span data-key="beforeUnload">@Localizer["Your file is still uploading. Are you sure to quit?"]</span>
</div>
</div>
<script type="module" src="~/js/file-upload.js" asp-append-version="true"></script>
