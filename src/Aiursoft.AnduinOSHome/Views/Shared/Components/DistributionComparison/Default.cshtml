@using Aiursoft.AnduinOSHome.Views.Shared.Components.DistributionComparison
@model DistributionComparisonViewModel

@{
    var competitors = new[]
    {
        (Key: "zorin", Name: "Zorin OS", Version: "18.1", ShortName: "Zorin", Mark: "Z"),
        (Key: "mint", Name: "Linux Mint", Version: "22.3", ShortName: "Mint", Mark: "lm"),
        (Key: "ubuntu", Name: "Ubuntu", Version: "26.04 LTS", ShortName: "Ubuntu", Mark: "u")
    };
    var extraCount = Model.Items.Count(item => !item.IsCore);
}

<section class="comparison-section position-relative" id="compare" data-comparison-root>
    <div class="comparison-orb comparison-orb--blue" aria-hidden="true"></div>
    <div class="comparison-orb comparison-orb--violet" aria-hidden="true"></div>
    <div class="comparison-grid-glow" aria-hidden="true"></div>

    @* Static extraction catalog for text defined by DistributionComparison.cs.
       Runtime rendering uses the same keys through Localizer[item.*] and Localizer[cell.*].
       Keep this catalog in sync when adding or changing comparison data. *@
    <template id="comparison-localization-catalog">
        <span data-key="System foundation">@Localizer["System foundation"]</span>
        <span data-key="Ubuntu version and Linux kernel">@Localizer["Ubuntu version and Linux kernel"]</span>
        <span data-key="Ubuntu 26.04 LTS · Linux 7.0">@Localizer["Ubuntu 26.04 LTS · Linux 7.0"]</span>
        <span data-key="AnduinOS 2 is based on Ubuntu 26.04 LTS and its Linux 7.0 kernel. The kernel connects software to your hardware. AnduinOS keeps this foundation through installation and normal updates, rather than changing it only in the installation image.">@Localizer["AnduinOS 2 is based on Ubuntu 26.04 LTS and its Linux 7.0 kernel. The kernel connects software to your hardware. AnduinOS keeps this foundation through installation and normal updates, rather than changing it only in the installation image."]</span>
        <span data-key="Ubuntu 24.04 · Linux 6.17">@Localizer["Ubuntu 24.04 · Linux 6.17"]</span>
        <span data-key="Zorin OS 18.1 uses Ubuntu 24.04 LTS and Linux 6.17. Its desktop and system software follow the Ubuntu 24.04 base; a newer kernel does not by itself bring the desktop features of Ubuntu 26.04 or GNOME 50.">@Localizer["Zorin OS 18.1 uses Ubuntu 24.04 LTS and Linux 6.17. Its desktop and system software follow the Ubuntu 24.04 base; a newer kernel does not by itself bring the desktop features of Ubuntu 26.04 or GNOME 50."]</span>
        <span data-key="Ubuntu 24.04 · Linux 6.14 or 7.0 HWE">@Localizer["Ubuntu 24.04 · Linux 6.14 or 7.0 HWE"]</span>
