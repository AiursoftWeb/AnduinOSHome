@model Aiursoft.AnduinOSHome.Models.HardwareViewModels.HardwareDetailsModel
@inject Aiursoft.AnduinOSHome.Services.FileStorage.StorageService Storage
@inject Aiursoft.AnduinOSHome.Services.HardwareLabels Labels
<div class="container py-5">
<a asp-action="Index">@Localizer["All recommended hardware"]</a>
<h1 class="mt-3">@Model.Device.Brand @Model.Device.Model</h1>
<p class="lead">@Model.Text.Description</p>
@if (Model.Device.TeamDevice) {
<div class="alert alert-success"><strong>@Localizer["Used by the AnduinOS development team"]</strong>
<p class="mb-0">@Localizer["This is a device used by our team for development and testing. See the individual verification results below."]</p></div>
}
<div class="row">
@if (!string.IsNullOrWhiteSpace(Model.Device.ProductImagePath)) { <div class="col-md-6 mb-3"><a href="@Storage.RelativePathToInternetUrl(Model.Device.ProductImagePath)"><img src="@Storage.RelativePathToInternetUrl(Model.Device.ProductImagePath)?w=1000" class="img-fluid rounded" loading="lazy" alt="@Localizer["Product image"]" /></a></div> }
@if (!string.IsNullOrWhiteSpace(Model.Device.ExperienceImagePath)) { <div class="col-md-6 mb-3"><a href="@Storage.RelativePathToInternetUrl(Model.Device.ExperienceImagePath)"><img src="@Storage.RelativePathToInternetUrl(Model.Device.ExperienceImagePath)?w=1000" class="img-fluid rounded" loading="lazy" alt="@Localizer["AnduinOS running on this device"]" /></a></div> }
</div><dl class="row">
<dt class="col-sm-4">@Localizer["Architecture"]</dt><dd class="col-sm-8">@Model.Device.Architecture</dd>
<dt class="col-sm-4">@Localizer["Category"]</dt><dd class="col-sm-8">@Model.Device.Category</dd>
<dt class="col-sm-4">@Localizer["Tested hardware configuration"]</dt><dd class="col-sm-8">@Model.Device.Configuration</dd>
<dt class="col-sm-4">@Localizer["Price market and configuration"]</dt><dd class="col-sm-8">@Model.Device.PriceMarket</dd>
<dt class="col-sm-4">@Localizer["Price checked on"]</dt><dd class="col-sm-8">@(Model.Device.PriceCheckedAt?.ToString("yyyy-MM-dd"))</dd>
<dt class="col-sm-4">@Localizer["Image credit and permission"]</dt><dd class="col-sm-8">@Model.Device.ImageCredit</dd>
<dt class="col-sm-4">@Localizer["Tested AnduinOS version"]</dt><dd class="col-sm-8">@Model.Device.TestedVersion</dd>
<dt class="col-sm-4">@Localizer["Tested kernel"]</dt><dd class="col-sm-8">@Model.Device.KernelVersion</dd>
<dt class="col-sm-4">@Localizer["Tested drivers"]</dt><dd class="col-sm-8">@Model.Device.DriverVersion</dd>
<dt class="col-sm-4">@Localizer["Last verified on"]</dt><dd class="col-sm-8">@(Model.Device.VerifiedAt?.ToString("yyyy-MM-dd"))</dd>
@if (Model.Device.PriceUsd.HasValue) { <dt class="col-sm-4">@Localizer["Reference price"]</dt><dd class="col-sm-8">US$ @Model.Device.PriceUsd <small>@Localizer["Not a quotation; prices and availability may change."]</small></dd> }
<dt class="col-sm-4">@Localizer["Installation"]</dt><dd class="col-sm-8">@Labels.Label(Model.Device.Installation)</dd>
<dt class="col-sm-4">@Localizer["Virtualization (KVM)"]</dt><dd class="col-sm-8">@Labels.Label(Model.Device.Virtualization)</dd>
<dt class="col-sm-4">@Localizer["Desktop performance"]</dt><dd class="col-sm-8">@Labels.Label(Model.Device.Performance)</dd>
<dt class="col-sm-4">@Localizer["Wi-Fi in Live"]</dt><dd class="col-sm-8">@Labels.Label(Model.Device.Wifi)</dd>
<dt class="col-sm-4">@Localizer["Graphics acceleration"]</dt><dd class="col-sm-8">@Labels.Label(Model.Device.Graphics)</dd>
<dt class="col-sm-4">@Localizer["Display scaling"]</dt><dd class="col-sm-8">@Labels.Label(Model.Device.Display)</dd>
<dt class="col-sm-4">@Localizer["Secure Boot"]</dt><dd class="col-sm-8">@Labels.Label(Model.Device.SecureBoot)</dd>
</dl>
@if (!string.IsNullOrWhiteSpace(Model.Text.InstallationNotes)) { <h2 class="h4">@Localizer["Installation instructions"]</h2><p style="white-space:pre-wrap">@Model.Text.InstallationNotes</p> }
@if (!string.IsNullOrWhiteSpace(Model.Text.FirmwareNotes)) { <h2 class="h4">@Localizer["Firmware and peripheral support"]</h2><p style="white-space:pre-wrap">@Model.Text.FirmwareNotes</p> }
@if (!string.IsNullOrWhiteSpace(Model.Text.KnownIssues)) { <h2 class="h4">@Localizer["Known limitations"]</h2><p style="white-space:pre-wrap">@Model.Text.KnownIssues</p> }
@if (!string.IsNullOrWhiteSpace(Model.Device.ProductUrl)) { <p><a href="@Model.Device.ProductUrl" rel="noopener noreferrer" target="_blank">@Localizer["Manufacturer and price source"]</a></p> }
@if (!string.IsNullOrWhiteSpace(Model.Device.ReportUrl)) { <p><a href="@Model.Device.ReportUrl" rel="noopener noreferrer" target="_blank">@Localizer["Installation guide or test report"]</a></p> }
@if (!string.IsNullOrWhiteSpace(Model.Device.ImageSourceUrl)) { <p><a href="@Model.Device.ImageSourceUrl" rel="noopener noreferrer" target="_blank">@Localizer["Image source"]</a></p> }
<p class="text-muted">@Localizer["Results apply to the listed configuration and software versions. An untested feature is not necessarily unsupported."]</p></div>
