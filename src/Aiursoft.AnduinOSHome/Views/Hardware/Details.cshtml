@model Aiursoft.AnduinOSHome.Models.HardwareViewModels.HardwareDetailsModel
@inject Aiursoft.AnduinOSHome.Services.FileStorage.StorageService Storage
@inject Aiursoft.AnduinOSHome.Services.HardwareLabels Labels
@{
    var highlights = new[]
    {
        new Aiursoft.AnduinOSHome.Models.HardwareViewModels.HardwareInsightModel(Localizer["Installation"].Value, Labels.Label(Model.Device.Installation), "hard-drive-download", Model.Device.Installation, Model.Detail(x => x.InstallationDetail), true),
        new Aiursoft.AnduinOSHome.Models.HardwareViewModels.HardwareInsightModel(Localizer["Desktop performance"].Value, Labels.Label(Model.Device.Performance), "zap", Model.Device.Performance, Model.Detail(x => x.PerformanceDetail), true),
        new Aiursoft.AnduinOSHome.Models.HardwareViewModels.HardwareInsightModel(Localizer["Secure Boot"].Value, Labels.Label(Model.Device.SecureBoot), "shield-check", Model.Device.SecureBoot, Model.Detail(x => x.SecureBootDetail), true)
    };
    var capabilities = new[]
    {
        new Aiursoft.AnduinOSHome.Models.HardwareViewModels.HardwareInsightModel(Localizer["Wi-Fi in Live"].Value, Labels.Label(Model.Device.Wifi), "wifi", Model.Device.Wifi, Model.Detail(x => x.WifiDetail), false),
        new Aiursoft.AnduinOSHome.Models.HardwareViewModels.HardwareInsightModel(Localizer["Graphics acceleration"].Value, Labels.Label(Model.Device.Graphics), "monitor", Model.Device.Graphics, Model.Detail(x => x.GraphicsDetail), false),
        new Aiursoft.AnduinOSHome.Models.HardwareViewModels.HardwareInsightModel(Localizer["Virtualization (KVM)"].Value, Labels.Label(Model.Device.Virtualization), "boxes", Model.Device.Virtualization, Model.Detail(x => x.VirtualizationDetail), false),
        new Aiursoft.AnduinOSHome.Models.HardwareViewModels.HardwareInsightModel(Localizer["Display scaling"].Value, Labels.Label(Model.Device.Display), "scan", Model.Device.Display, Model.Detail(x => x.DisplayDetail), false)
    };
}

<vc:marketing-navbar></vc:marketing-navbar>
@if (Model.IsPreview) { <div class="alert alert-warning text-center mb-0" role="status">@Localizer["Editorial preview — unpublished changes appear only after saving."]</div> }

<main class="hardware-detail">
    @* The insight labels are constructed in the Razor code block above. Keep direct calls for dotlang extraction. *@
    <template id="hardware-details-localization-catalog">
        <span>@Localizer["Installation"]</span>
        <span>@Localizer["Desktop performance"]</span>
        <span>@Localizer["Secure Boot"]</span>
        <span>@Localizer["Wi-Fi in Live"]</span>
        <span>@Localizer["Graphics acceleration"]</span>
        <span>@Localizer["Virtualization (KVM)"]</span>
        <span>@Localizer["Display scaling"]</span>
    </template>
    <div class="hardware-orb hardware-orb--blue" aria-hidden="true"></div>
    <div class="hardware-orb hardware-orb--violet" aria-hidden="true"></div>
    <div class="container hardware-content">
        <nav class="hardware-breadcrumb" aria-label="@Localizer["Breadcrumb"]">
            <a asp-action="Index"><i data-lucide="arrow-left" aria-hidden="true"></i> @Localizer["All recommended hardware"]</a>
            <span aria-hidden="true">/</span><span aria-current="page">@Model.Device.Brand @Model.Device.Model</span>
        </nav>
        <header class="hardware-hero">
            <div class="hardware-hero-copy">
                <div class="hardware-kicker"><span class="hardware-kicker-dot" aria-hidden="true"></span>@Localizer["Tested on real hardware"]</div>
                <div class="hardware-tags"><span>@Model.Device.Architecture</span>@if (Model.Device.DeviceType != Aiursoft.AnduinOSHome.Entities.HardwareDeviceType.Unspecified) { <span>@Labels.Label(Model.Device.DeviceType)</span> } else if (!string.IsNullOrWhiteSpace(Model.Device.Category)) { <span>@Model.Device.Category</span> }</div>
                <h1>@Model.Device.Brand <span>@Model.Device.Model</span></h1>
                <p class="hardware-intro">@Model.Text.Description</p>
                @if (Model.Device.PriceUsd.HasValue || Model.Device.VerifiedAt.HasValue)
                {
                    <div class="hardware-meta">
                        @if (Model.Device.PriceUsd.HasValue) { <div><small>@Localizer["Reference price"]</small><strong>US$ @Model.Device.PriceUsd.Value.ToString("N0")</strong></div> }
                        @if (Model.Device.VerifiedAt.HasValue) { <div><small>@Localizer["Last verified on"]</small><strong>@Model.Device.VerifiedAt.Value.ToString("yyyy-MM-dd")</strong></div> }
                    </div>
                }
                @if (Model.Device.TeamDevice)
                {
                    <div class="hardware-team"><i data-lucide="badge-check" aria-hidden="true"></i><span><strong>@Localizer["Used by the AnduinOS development team"]</strong><small>@Localizer["Tested firsthand by the development team."]</small></span></div>
                }
            </div>
            <div class="hardware-hero-visual">
                @if (!string.IsNullOrWhiteSpace(Model.Device.ProductImagePath))
                {
                    <img src="@Storage.RelativePathToInternetUrl(Model.Device.ProductImagePath)?w=1000" alt="@Model.Device.Brand @Model.Device.Model" />
                }
                else
                {
                    <i class="hardware-image-placeholder" data-lucide="monitor" aria-hidden="true"></i>
                }
                <span class="hardware-image-caption">@Localizer["Hardware profile"] <span>·</span> @Model.Device.Architecture</span>
            </div>
        </header>

        <div class="hardware-light-band">
        <section class="hardware-section" aria-labelledby="hardware-highlights-title">
            <div class="hardware-section-heading"><span>01 / @Localizer["Overview"]</span><h2 id="hardware-highlights-title">@Localizer["The essentials, at a glance."]</h2></div>
            <div class="hardware-highlights">
                @foreach (var insight in highlights) { <partial name="~/Views/Hardware/_HardwareInsight.cshtml" model="insight" /> }
            </div>
        </section>

        <section class="hardware-section" aria-labelledby="hardware-capabilities-title">
            <div class="hardware-section-heading"><span>02 / @Localizer["Compatibility"]</span><h2 id="hardware-capabilities-title">@Localizer["What works on this device."]</h2><p>@Localizer["Each status reflects the listed configuration and tested software version."]</p></div>
            <div class="hardware-capabilities">
                @foreach (var insight in capabilities) { <partial name="~/Views/Hardware/_HardwareInsight.cshtml" model="insight" /> }
            </div>
        </section>
        </div>

        <dialog class="hardware-insight-dialog" data-hardware-dialog aria-labelledby="hardware-insight-title">
            <div class="hardware-insight-dialog-panel">
                <header><div><span>@Localizer["Compatibility detail"]</span><h2 id="hardware-insight-title" data-hardware-dialog-title></h2></div><button type="button" data-hardware-dialog-close aria-label="@Localizer["Close details"]"><i data-lucide="x" aria-hidden="true"></i></button></header>
                <div class="hardware-insight-dialog-body"><div class="hardware-insight-dialog-status" data-hardware-dialog-status></div><p data-hardware-dialog-detail></p></div>
                <footer><span>@Model.Device.Brand @Model.Device.Model</span><button type="button" data-hardware-dialog-close>@Localizer["Done"]</button></footer>
            </div>
        </dialog>

        @if (!string.IsNullOrWhiteSpace(Model.Text.InstallationNotes) || !string.IsNullOrWhiteSpace(Model.Text.FirmwareNotes) || !string.IsNullOrWhiteSpace(Model.Text.KnownIssues))
        {
            <section class="hardware-section" aria-labelledby="hardware-notes-title">
                <div class="hardware-section-heading"><span>03 / @Localizer["Field notes"]</span><h2 id="hardware-notes-title">@Localizer["From the test bench."]</h2></div>
                <div class="hardware-notes">
                    @if (!string.IsNullOrWhiteSpace(Model.Text.InstallationNotes))
                    {
                        <article class="hardware-note hardware-note--primary"><span class="hardware-note-icon"><i data-lucide="disc-3" aria-hidden="true"></i></span><h3>@Localizer["Installation instructions"]</h3><p>@Model.Text.InstallationNotes</p></article>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Text.FirmwareNotes))
                    {
                        <article class="hardware-note"><span class="hardware-note-icon"><i data-lucide="scan-line" aria-hidden="true"></i></span><h3>@Localizer["Firmware and peripheral support"]</h3><p>@Model.Text.FirmwareNotes</p></article>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Text.KnownIssues))
                    {
                        <article class="hardware-note"><span class="hardware-note-icon"><i data-lucide="info" aria-hidden="true"></i></span><h3>@Localizer["Known limitations"]</h3><p>@Model.Text.KnownIssues</p></article>
                    }
                </div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Device.ExperienceImagePath))
        {
            <section class="hardware-section" aria-labelledby="hardware-experience-title">
                <div class="hardware-section-heading"><span>04 / @Localizer["In use"]</span><h2 id="hardware-experience-title">@Localizer["AnduinOS on this device."]</h2></div>
                <a class="hardware-experience" href="@Storage.RelativePathToInternetUrl(Model.Device.ExperienceImagePath)"><img src="@Storage.RelativePathToInternetUrl(Model.Device.ExperienceImagePath)?w=1400" loading="lazy" alt="@Localizer["AnduinOS running on this device"]" /></a>
            </section>
        }

        <section class="hardware-section hardware-section--technical" aria-labelledby="hardware-technical-title">
            <div class="hardware-section-heading"><span>@Localizer["Technical record"]</span><h2 id="hardware-technical-title">@Localizer["The configuration we tested."]</h2></div>
            <div class="hardware-specs">
                <div><span>@Localizer["Architecture"]</span><strong>@Model.Device.Architecture</strong></div>
                @if (Model.Device.DeviceType != Aiursoft.AnduinOSHome.Entities.HardwareDeviceType.Unspecified) { <div><span>@Localizer["Device type"]</span><strong>@Labels.Label(Model.Device.DeviceType)</strong></div> }
                @if (!string.IsNullOrWhiteSpace(Model.Device.Sku)) { <div><span>@Localizer["SKU"]</span><strong>@Model.Device.Sku</strong></div> }
                @if (!string.IsNullOrWhiteSpace(Model.Configuration)) { <div><span>@Localizer["Tested hardware configuration"]</span><strong>@Model.Configuration</strong></div> }
                @if (!string.IsNullOrWhiteSpace(Model.Device.TestedVersion)) { <div><span>@Localizer["Tested AnduinOS version"]</span><strong>@Model.Device.TestedVersion</strong></div> }
                @if (!string.IsNullOrWhiteSpace(Model.Device.KernelVersion)) { <div><span>@Localizer["Tested kernel"]</span><strong>@Model.Device.KernelVersion</strong></div> }
                @if (!string.IsNullOrWhiteSpace(Model.Device.DriverVersion)) { <div><span>@Localizer["Tested drivers"]</span><strong>@Model.Device.DriverVersion</strong></div> }
                @if (!string.IsNullOrWhiteSpace(Model.Device.PriceMarket)) { <div><span>@Localizer["Price market and configuration"]</span><strong>@Model.Device.PriceMarket</strong></div> }
                @if (Model.Device.PriceCheckedAt.HasValue) { <div><span>@Localizer["Price checked on"]</span><strong>@Model.Device.PriceCheckedAt.Value.ToString("yyyy-MM-dd")</strong></div> }
            </div>
            <div class="hardware-sources">
                @if (!string.IsNullOrWhiteSpace(Model.Device.ProductUrl)) { <a href="@Model.Device.ProductUrl" rel="noopener noreferrer" target="_blank">@Localizer["Manufacturer and price source"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a> }
                @if (!string.IsNullOrWhiteSpace(Model.Device.ReportUrl)) { <a href="@Model.Device.ReportUrl" rel="noopener noreferrer" target="_blank">@Localizer["Installation guide or test report"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a> }
                @if (!string.IsNullOrWhiteSpace(Model.Device.ImageSourceUrl)) { <a href="@Model.Device.ImageSourceUrl" rel="noopener noreferrer" target="_blank">@Localizer["Image source"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a> }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ImageCredit)) { <p class="hardware-credit">@Model.ImageCredit</p> }
            <p class="hardware-scope">@Localizer["Results apply to the listed configuration and software versions. An untested feature is not necessarily unsupported."]</p>
        </section>
    </div>
</main>

<vc:marketing-footer></vc:marketing-footer>

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hardware.css" asp-append-version="true" />
}
@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/js/hardware-details.js" asp-append-version="true" defer></script>
}
