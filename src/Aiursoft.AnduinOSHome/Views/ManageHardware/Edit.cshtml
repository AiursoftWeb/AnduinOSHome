@using Aiursoft.AnduinOSHome.Entities
@model Aiursoft.AnduinOSHome.Models.HardwareViewModels.HardwareEditModel
@inject Aiursoft.AnduinOSHome.Services.HardwareLabels Labels
@inject Aiursoft.AnduinOSHome.Services.FileStorage.StorageService Storage
<div class="d-flex justify-content-between align-items-center"><div><p class="text-muted mb-1">@Localizer["Hardware workspace"]</p>@if (Model.Device.Id == 0) { <h1>@Localizer["Add hardware"]</h1> } else { <h1>@Model.Device.Brand @Model.Device.Model</h1> }</div><div>@if (Model.Device.Id != 0) { <a asp-action="Preview" asp-route-id="@Model.Device.Id" target="_blank" class="btn btn-outline-secondary">@Localizer["Preview"]</a> } <button form="hardware-edit-form" class="btn btn-primary">@Localizer["Save"]</button> <button type="button" id="hardware-publish" class="btn btn-success">@Localizer["Publish"]</button></div></div>
<nav class="nav nav-tabs mb-4" aria-label="@Localizer["Hardware workspace"]"><a asp-action="Edit" asp-route-id="@Model.Device.Id" class="nav-link active">@Localizer["Edit device"]</a>@if (Model.Device.Id != 0) { <a asp-action="Localize" asp-route-id="@Model.Device.Id" class="nav-link">@Localizer["Translations"]</a> }</nav>
<p>@Localizer["Write the full review in the source language. Shared facts apply to every language."]</p>
@if (Model.Device.Id != 0)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center gap-3">
        <span>@Localizer["Write the original review here. Translate it on the Languages tab. Changes to original text mark translations for review."]</span>
        <a asp-action="Localize" asp-route-id="@Model.Device.Id" class="btn btn-primary">@Localizer["Edit translations"]</a>
    </div>
}
<div class="row g-4"><div class="col-xl-8">
<form id="hardware-edit-form" asp-action="Edit" asp-route-id="@Model.Device.Id" method="post">
<div asp-validation-summary="All" class="text-danger"></div>
<input asp-for="Device.Id" type="hidden" />
@if (Model.SourceCultureLocked) { <input asp-for="Device.SourceCulture" type="hidden" /> }
<h2 class="h4 mt-4">@Localizer["Device and display"]</h2><p class="text-muted small">@Localizer["Shown on the home card, catalog, and detail hero. Shared across all languages."]</p>
<p class="alert alert-warning">@Localizer["Images are public immediately after upload. Use only images you have permission to publish. Archive a record to remove it from public pages."]</p>
<div class="row">
@if (Model.SourceCultureLocked)
{
    <div class="col-md-6 mb-3"><label>@Localizer["Source language"]</label><p>@Model.Device.SourceCulture</p></div>
}
else
{
    <div class="col-md-6 mb-3"><label asp-for="Device.SourceCulture">@Localizer["Source language"]</label><select asp-for="Device.SourceCulture" class="form-select">@foreach (var code in Aiursoft.WebTools.OfficialPlugins.LocalizationPlugin.SupportedCultures.Keys) { <option value="@code">@System.Globalization.CultureInfo.GetCultureInfo(code).NativeName</option> }</select><div class="form-text">@Localizer["Choose the language of the original review. It cannot be changed after creation."]</div></div>
}
<div class="col-md-6 mb-3"><label asp-for="Device.Slug">@Localizer["URL name"]</label><input asp-for="Device.Slug"   class="form-control" /><span asp-validation-for="Device.Slug" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="Device.Brand">@Localizer["Brand"]</label><input asp-for="Device.Brand"   class="form-control" /><span asp-validation-for="Device.Brand" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="Device.Model">@Localizer["Model"]</label><input asp-for="Device.Model"   class="form-control" /><span asp-validation-for="Device.Model" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="Device.Sku">@Localizer["SKU (exact sales configuration, if known)"]</label><input asp-for="Device.Sku" class="form-control" /><span asp-validation-for="Device.Sku" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="Device.Architecture">@Localizer["Architecture"]</label><input asp-for="Device.Architecture"   class="form-control" /><span asp-validation-for="Device.Architecture" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="Device.DeviceType">@Localizer["Device type"]</label><select asp-for="Device.DeviceType" class="form-select">@foreach (var value in Enum.GetValues<HardwareDeviceType>()) { <option value="@((int)value)">@Labels.Label(value)</option> }</select><span asp-validation-for="Device.DeviceType" class="text-danger"></span></div>
<input asp-for="Device.Category" type="hidden" />
<div class="col-md-6 mb-3"><label asp-for="Device.PriceUsd">@Localizer["Reference price (USD)"]</label><input asp-for="Device.PriceUsd" type="number" class="form-control" /></div>
<div class="col-md-6 mb-3"><input asp-for="Device.TeamDevice" class="form-check-input" /><label asp-for="Device.TeamDevice">@Localizer["Used by the AnduinOS development team"]</label></div>
<div class="col-md-6 mb-3"><input asp-for="Device.Featured" class="form-check-input" /><label asp-for="Device.Featured">@Localizer["Featured on the home page"]</label></div>
<div class="col-md-6 mb-3"><label asp-for="Device.ProductImagePath">@Localizer["Product image (transparent PNG or WebP recommended)"]</label><vc:file-upload asp-for="Device.ProductImagePath" subfolder="hardware" allowed-extensions="png jpg jpeg webp" max-size-in-mb="10"></vc:file-upload><span asp-validation-for="Device.ProductImagePath" class="text-danger"></span><input asp-for="ClearProductImage" /> <label asp-for="ClearProductImage">@Localizer["Remove product image reference"]</label></div>
<div class="col-md-6 mb-3"><label asp-for="Device.ExperienceImagePath">@Localizer["Photo of AnduinOS running on this device"]</label><vc:file-upload asp-for="Device.ExperienceImagePath" subfolder="hardware" allowed-extensions="png jpg jpeg webp" max-size-in-mb="10"></vc:file-upload><span asp-validation-for="Device.ExperienceImagePath" class="text-danger"></span><input asp-for="ClearExperienceImage" /> <label asp-for="ClearExperienceImage">@Localizer["Remove experience photo reference"]</label></div>
<div class="col-12"><h2 id="device-intro" class="h4">@Localizer["Introduction"]</h2><p class="text-muted small">@Localizer["Shown in the detail hero. Write in the source language; translations are optional."]</p></div>
<div class="col-12 mb-3"><label asp-for="Text.Description">@Localizer["Description"] · @Model.Device.SourceCulture</label><textarea asp-for="Text.Description" class="form-control" rows="4" maxlength="3000"></textarea><span asp-validation-for="Text.Description" class="text-danger"></span></div>
<div class="col-12"><h2 id="device-overview" class="h4">@Localizer["Overview"]</h2><p class="text-muted small">@Localizer["Each verdict controls the icon; its explanation appears when visitors click the card. Shared verdict, source-language explanation."]</p></div>
<div class="col-md-6 mb-3"><label asp-for="Device.Installation">@Localizer["Installation"]</label><select asp-for="Device.Installation" class="form-select">@foreach (var value in Enum.GetValues<HardwareEase>()) { <option value="@((int)value)">@Labels.Label(value)</option> }</select><label asp-for="Text.InstallationDetail">@Localizer["Installation detail"]</label><textarea asp-for="Text.InstallationDetail" maxlength="2000" class="form-control"></textarea></div>
<div class="col-md-6 mb-3"><label asp-for="Device.Performance">@Localizer["Desktop performance"]</label><select asp-for="Device.Performance" class="form-select">@foreach (var value in Enum.GetValues<HardwarePerformance>()) { <option value="@((int)value)">@Labels.Label(value)</option> }</select><label asp-for="Text.PerformanceDetail">@Localizer["Desktop performance detail"]</label><textarea asp-for="Text.PerformanceDetail" maxlength="2000" class="form-control"></textarea></div>
<div class="col-md-6 mb-3"><label asp-for="Device.SecureBoot">@Localizer["Secure Boot"]</label><select asp-for="Device.SecureBoot" class="form-select">@foreach (var value in Enum.GetValues<HardwareSupport>()) { <option value="@((int)value)">@Labels.Label(value)</option> }</select><label asp-for="Text.SecureBootDetail">@Localizer["Secure Boot detail"]</label><textarea asp-for="Text.SecureBootDetail" maxlength="2000" class="form-control"></textarea></div>
<div class="col-12"><h2 id="device-compatibility" class="h4">@Localizer["Compatibility"]</h2><p class="text-muted small">@Localizer["Shown in the compatibility cards on the device detail page."]</p></div>
<div class="col-md-6 mb-3"><label asp-for="Device.Wifi">@Localizer["Wi-Fi in Live"]</label><select asp-for="Device.Wifi" class="form-select">@foreach (var value in Enum.GetValues<HardwareSupport>()) { <option value="@((int)value)">@Labels.Label(value)</option> }</select><label asp-for="Text.WifiDetail">@Localizer["Wi-Fi in Live detail"]</label><textarea asp-for="Text.WifiDetail" maxlength="2000" class="form-control"></textarea></div>
<div class="col-md-6 mb-3"><label asp-for="Device.Graphics">@Localizer["Graphics acceleration"]</label><select asp-for="Device.Graphics" class="form-select">@foreach (var value in Enum.GetValues<HardwareGraphics>()) { <option value="@((int)value)">@Labels.Label(value)</option> }</select><label asp-for="Text.GraphicsDetail">@Localizer["Graphics acceleration detail"]</label><textarea asp-for="Text.GraphicsDetail" maxlength="2000" class="form-control"></textarea></div>
<div class="col-md-6 mb-3"><label asp-for="Device.Virtualization">@Localizer["Virtualization (KVM)"]</label><select asp-for="Device.Virtualization" class="form-select">@foreach (var value in Enum.GetValues<HardwareEase>()) { <option value="@((int)value)">@Labels.Label(value)</option> }</select><label asp-for="Text.VirtualizationDetail">@Localizer["Virtualization (KVM) detail"]</label><textarea asp-for="Text.VirtualizationDetail" maxlength="2000" class="form-control"></textarea></div>
<div class="col-md-6 mb-3"><label asp-for="Device.Display">@Localizer["Display scaling"]</label><select asp-for="Device.Display" class="form-select">@foreach (var value in Enum.GetValues<HardwareSupport>()) { <option value="@((int)value)">@Labels.Label(value)</option> }</select><label asp-for="Text.DisplayDetail">@Localizer["Display scaling detail"]</label><textarea asp-for="Text.DisplayDetail" maxlength="2000" class="form-control"></textarea></div>
<div class="col-12"><h2 id="device-notes" class="h4">@Localizer["Field notes"]</h2><p class="text-muted small">@Localizer["Shown below the compatibility cards."]</p></div>
<div class="col-md-6 mb-3"><label asp-for="Text.InstallationNotes">@Localizer["Installation instructions"]</label><textarea asp-for="Text.InstallationNotes" class="form-control" rows="4" maxlength="3000"></textarea></div>
<div class="col-md-6 mb-3"><label asp-for="Text.FirmwareNotes">@Localizer["Firmware and peripheral support"]</label><textarea asp-for="Text.FirmwareNotes" class="form-control" rows="4" maxlength="3000"></textarea></div>
<div class="col-md-6 mb-3"><label asp-for="Text.KnownIssues">@Localizer["Known limitations"]</label><textarea asp-for="Text.KnownIssues" class="form-control" rows="4" maxlength="3000"></textarea></div>
<div class="col-12"><h2 id="device-record" class="h4">@Localizer["Technical record"]</h2><p class="text-muted small">@Localizer["Localized text supplements shared technical values."]</p></div>
<div class="col-md-6 mb-3"><label asp-for="Device.Configuration">@Localizer["Tested hardware configuration"]</label><input asp-for="Device.Configuration" class="form-control" /></div>
<div class="col-md-6 mb-3"><label asp-for="Text.ConfigurationText">@Localizer["Localized hardware configuration"]</label><textarea asp-for="Text.ConfigurationText" class="form-control" maxlength="1000"></textarea></div>
<div class="col-md-6 mb-3"><label asp-for="Device.TestedVersion">@Localizer["Tested AnduinOS version"]</label><input asp-for="Device.TestedVersion" class="form-control" /></div>
<div class="col-md-6 mb-3"><label asp-for="Device.KernelVersion">@Localizer["Tested kernel"]</label><input asp-for="Device.KernelVersion" class="form-control" /></div>
<div class="col-md-6 mb-3"><label asp-for="Device.DriverVersion">@Localizer["Tested drivers"]</label><input asp-for="Device.DriverVersion" class="form-control" /></div>
<div class="col-md-6 mb-3"><label asp-for="Device.VerifiedAt">@Localizer["Last verified on"]</label><input asp-for="Device.VerifiedAt" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /></div>
<div class="col-md-6 mb-3"><label asp-for="Device.PriceMarket">@Localizer["Price market and configuration"]</label><input asp-for="Device.PriceMarket" class="form-control" /></div>
<div class="col-md-6 mb-3"><label asp-for="Device.PriceCheckedAt">@Localizer["Price checked on"]</label><input asp-for="Device.PriceCheckedAt" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /></div>
<div class="col-md-6 mb-3"><label asp-for="Device.ProductUrl">@Localizer["Product and price source URL"]</label><input asp-for="Device.ProductUrl" type="url" class="form-control" /></div>
<div class="col-md-6 mb-3"><label asp-for="Device.ReportUrl">@Localizer["Installation guide or test report URL"]</label><input asp-for="Device.ReportUrl" type="url" class="form-control" /></div>
<div class="col-md-6 mb-3"><label asp-for="Device.ImageSourceUrl">@Localizer["Product image source URL"]</label><input asp-for="Device.ImageSourceUrl" type="url" class="form-control" /></div>
<div class="col-md-6 mb-3"><label asp-for="Device.ImageCredit">@Localizer["Image credit and permission"]</label><input asp-for="Device.ImageCredit" class="form-control" /></div>
<div class="col-md-6 mb-3"><label asp-for="Text.ImageCreditText">@Localizer["Localized image credit"]</label><textarea asp-for="Text.ImageCreditText" class="form-control" maxlength="500"></textarea></div>
<div class="col-md-6 mb-3"><label asp-for="Device.SortOrder">@Localizer["Sort order"]</label><input asp-for="Device.SortOrder" type="number" class="form-control" /></div>
<div class="col-md-6 mb-3"><label asp-for="Device.Publication">@Localizer["Publication"]</label><select asp-for="Device.Publication" class="form-select">@foreach (var value in Enum.GetValues<HardwarePublication>()) { <option value="@((int)value)">@Labels.Label(value)</option> }</select></div>
</div><button class="btn btn-primary">@Localizer["Save"]</button> <a asp-action="Index">@Localizer["Back to hardware"]</a>
</form>
</div><aside class="col-xl-4"><div class="card position-sticky" style="top:1rem"><div class="card-body"><h2 class="h5">@Localizer["Card preview"]</h2><span id="hardware-preview-unsaved" class="badge text-bg-warning d-none">@Localizer["Unsaved preview"]</span>
@if (!string.IsNullOrWhiteSpace(Model.Device.ProductImagePath)) { <img id="hardware-preview-image" src="@Storage.RelativePathToInternetUrl(Model.Device.ProductImagePath)?w=600" class="w-100 p-3" style="height:220px;object-fit:contain" alt="" /> }
else { <img id="hardware-preview-image" class="w-100 p-3 d-none" style="height:220px;object-fit:contain" alt="" /> }
<div class="text-center"><h3 id="hardware-preview-name" class="h5">@Model.Device.Brand @Model.Device.Model</h3><p id="hardware-preview-price" class="text-muted">@(Model.Device.PriceUsd.HasValue ? $"US$ {Model.Device.PriceUsd.Value:N0}" : "—")</p></div>
@if (Model.Device.Id != 0) { <a asp-action="Preview" asp-route-id="@Model.Device.Id" target="_blank" class="btn btn-outline-secondary w-100">@Localizer["Preview"]</a> }
</div></div></aside></div>
@* Sections are provided by the UiStack Razor class library layout. *@
@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
<link rel="stylesheet" href="~/node_modules/dropify/dist/css/dropify.min.css" />
<link rel="stylesheet" href="~/styles/uploader.css" />
}
@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
<script src="~/node_modules/dropify/dist/js/dropify.min.js"></script>
<script src="~/js/hardware-edit.js" asp-append-version="true" defer></script>
}
