<div class="container-fluid p-4">
    <h1 class="h3 mb-3">AnduinOS</h1>
    <p class="text-muted mb-4">@Localizer["Download AnduinOS, read the documentation, and explore previous releases."]</p>
    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="card h-100 mb-0">
                <div class="card-body">
                    <h2 class="h5 card-title"><a asp-controller="Home" asp-action="Index">@Localizer["Download AnduinOS"]</a></h2>
                    <p class="card-text">@Localizer["Find the latest release and choose your architecture."]</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card h-100 mb-0">
                <div class="card-body">
                    <h2 class="h5 card-title"><a href="https://docs.anduinos.com/">@Localizer["Documentation"]</a></h2>
                    <p class="card-text">@Localizer["Read installation instructions and guides for using AnduinOS."]</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card h-100 mb-0">
                <div class="card-body">
                    <h2 class="h5 card-title"><a asp-controller="Home" asp-action="HistoryBuilds">@Localizer["Previous releases"]</a></h2>
                    <p class="card-text">@Localizer["Browse older AnduinOS builds and release history."]</p>
                </div>
            </div>
        </div>
    </div>
</div>
